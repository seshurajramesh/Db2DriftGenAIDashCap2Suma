# Copy this to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://db2drift_usr:CHANGE_ME@127.0.0.1:5432/db2drift_db

# --- Azure AI Foundry ---
FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
FOUNDRY_DEPLOYMENT=db2-drift-analyzer-deepseek
FOUNDRY_API_KEY=CHANGE_ME

# --- Azure AI Search (RAG — optional, app runs fine without these set) ---
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=CHANGE_ME
AZURE_SEARCH_INDEX_NAME=db2-docs-index

# --- SSH to DB2 nodes ---
SSH_USER=azureuser
SSH_KEY_PATH=/home/azureuser/.ssh/id_rsa
SSH_KNOWN_HOSTS_PATH=/home/azureuser/.ssh/known_hosts
SSH_ALLOW_TRUST_ON_FIRST_USE=false

# --- API auth ---
# Comma-separated label:key pairs. Each caller sends X-API-Key: <key>.
API_KEYS=alice:CHANGE_ME_ALICE_KEY,bob:CHANGE_ME_BOB_KEY

# --- Optional: Slack/Teams webhook for HIGH risk drift alerts ---
ALERT_WEBHOOK_URL=
